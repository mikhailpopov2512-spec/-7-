# Prevent Git from corrupting binary files on push/pull
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.keystore binary

# Ensure correct line endings for scripts and text files
*.properties text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.kt text eol=lf
gradlew text eol=lf
